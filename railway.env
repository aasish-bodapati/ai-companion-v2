# Railway Deployment Environment Variables
# Copy these variables to Railway dashboard (one by one)

# Core Application Settings
NODE_ENV=production
MEMORY_ENABLED=false

# AI/LLM Configuration
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here

# Database (Railway will set this automatically when you create a PostgreSQL service)
# DATABASE_URL will be set by Railway

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Memory Settings (disabled for free tier)
MEMORY_IMPORTANCE_MIN=0.0
MEMORY_IMPORTANCE_MAX=1.0

# Optional: Logging
LOG_LEVEL=INFO
