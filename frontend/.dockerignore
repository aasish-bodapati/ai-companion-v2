# Exclude unnecessary files from Docker build context
# This will significantly reduce image size

# Dependencies (will be installed fresh)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing - EXCLUDE ALL TEST FILES
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
tests/
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
jest.config.ts
jest.setup.ts
tsconfig.jest.json

# Build artifacts (will be built fresh)
.next/
out/
dist/
build/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Cache
.cache/
cache/

# Documentation
docs/
*.md
README*

# Docker files (except the one we're using)
Dockerfile
docker-compose*.yml

# Large assets (if not needed)
public/large-images/
public/videos/
