{
  "name": "healthlog-ai-frontend",
  "version": "1.0.0",
  "description": "HealthLog AI - Your Personal Wellness Assistant Frontend",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev --turbo -H 0.0.0.0",
    "dev:webpack": "next dev -H 0.0.0.0",
    "dev:debug": "next dev --inspect -H 0.0.0.0",
    "dev:clean": "rm -rf .next && next dev -H 0.0.0.0",
    "dev:stable": "next dev --port 3000 -H 0.0.0.0",
    "dev:watch": "next dev --port 3000 -H 0.0.0.0",
    "dev:fast": "next dev --port 3000 --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.89.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.16",
    "lucide-react": "^0.544.0",
    "next": "^14.2.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
