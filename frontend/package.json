{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test --reporter=line --trace on-first-retry",
    "test:e2e:smoke": "playwright test --grep @smoke --reporter=line --trace on-first-retry",
    "test:e2e:regression": "playwright test --grep @regression --reporter=line --trace on-first-retry",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:batch": "node scripts/run-e2e-batches.js",
    "test:batch:smoke": "node scripts/run-e2e-batches.js batch smoke",
    "test:batch:auth": "node scripts/run-e2e-batches.js batch auth",
    "test:batch:navigation": "node scripts/run-e2e-batches.js batch navigation",
    "test:batch:regression": "node scripts/run-e2e-batches.js batch regression",
    "test:batch:full": "node scripts/run-e2e-batches.js batch full",
    "test:batch:quick": "node scripts/run-e2e-batches.js batch quick",
    "test:batch:ci": "node scripts/run-e2e-batches.js batch ci",
    "test:batch:all": "node scripts/run-e2e-batches.js all",
    "test:batch:dev": "node scripts/run-e2e-batches.js multiple quick,smoke",
    "test:batch:pre-commit": "node scripts/run-e2e-batches.js multiple smoke,auth",
    "test:batch:pr": "node scripts/run-e2e-batches.js multiple smoke,auth,navigation",
    "test:batch:release": "node scripts/run-e2e-batches.js multiple full,regression",
    "test:batch:list": "node scripts/run-e2e-batches.js list",
    "test:batch:shell": "./scripts/run-batches.sh",
    "test:batch:shell:dev": "./scripts/run-batches.sh preset development",
    "test:batch:shell:pre-commit": "./scripts/run-batches.sh preset pre-commit",
    "test:batch:shell:pr": "./scripts/run-batches.sh preset pull-request",
    "test:batch:shell:release": "./scripts/run-batches.sh preset release",
    "test:batch:shell:ci": "./scripts/run-batches.sh preset ci",
    "test:report": "node scripts/generate-test-report.js",
    "test:report:open": "node scripts/generate-test-report.js && open test-results/reports/batch-report.html",
    "test:demo": "echo '🧪 E2E Test Batch System Demo' && echo '' && echo 'Available commands:' && echo '  npm run test:batch:dev      - Development tests' && echo '  npm run test:batch:pre-commit - Pre-commit tests' && echo '  npm run test:batch:pr       - Pull request tests' && echo '  npm run test:batch:release  - Release tests' && echo '  npm run test:batch:list     - List all batches' && echo '  npm run test:report         - Generate reports' && echo '' && echo 'See scripts/README.md for detailed usage.'"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.84.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.539.0",
    "next": "^14.2.32",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  }
}
