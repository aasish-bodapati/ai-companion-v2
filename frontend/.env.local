# Frontend Environment Variables for Local Development
# Railway Backend API URL (commented out for local development)
# NEXT_PUBLIC_API_URL=https://ai-companion-v2-production.up.railway.app/api/v1

# Local Backend API URL (for development)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: Backend Health Check URL
NEXT_PUBLIC_API_HEALTH_URL=http://localhost:8000/api/v1/utils/health

# Optional: Enable/disable features
NEXT_PUBLIC_MEMORY_ENABLED=true
NEXT_PUBLIC_DEBUG_MODE=true