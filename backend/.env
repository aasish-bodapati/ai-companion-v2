# AI Companion V2 - Environment Configuration
# Generic LLM Provider Setup

# =============================================================================
# LLM Configuration - Generic Provider Setup
# =============================================================================
# Primary LLM Provider Configuration
LLM_PROVIDER=openrouter  # Options: gemini, openai, anthropic, openrouter, stub
LLM_DEV_MODE=false  # Disable dev mode to use real LLM
LLM_API_KEY=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
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration (OpenRouter models)
LLM_MODEL_DEFAULT=mistralai/mistral-7b-instruct
LLM_MODEL_FAST=mistralai/mistral-7b-instruct
LLM_MODEL_VISION=mistralai/mistral-7b-instruct
LLM_MODEL_SUMMARY=mistralai/mistral-7b-instruct



# =============================================================================
# Database Configuration
# =============================================================================
# Using SQLite for MVP - no database configuration needed
# The system will automatically use SQLite with data/minimal.db

# =============================================================================
# JWT Settings
# =============================================================================
SECRET_KEY=fEELdSfYJvpk6bfShEUXHG4sSaahAUmJzpcpa-UEhXH2gZagRqdebA3KKQEYBEf_
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# =============================================================================
# CORS Origins
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "https://yourapp.vercel.app", "https://api.yourdomain.com"]

# =============================================================================
# Memory System Configuration
# =============================================================================
MEMORY_ENABLED=true
MEMORY_PROVIDER=faiss
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_DATA_DIR=data/faiss
RETRIEVAL_TOP_K=12
RETRIEVAL_RECENT_MESSAGES=5

# =============================================================================
# Feature Flags
# =============================================================================
MEMORY_DECAY_ENABLED=true
PERSONALITY_REFLECTION_ENABLED=true
GOAL_TRACKING_ENABLED=true
AUTO_MEMORY_ENABLED=true
ACTIONS_SUGGESTIONS_ENABLED=true
DIRECT_EXECUTION_ENABLED=true

# =============================================================================
# Optional: Redis (Idempotency / Rate Limiting)
# =============================================================================
# e.g., redis://localhost:6379/0
REDIS_URL=redis://redis:6379
# TTL for idempotency records (seconds)
IDEMPOTENCY_TTL_SECONDS=600

# Rate limiting (requires Redis)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SEND_PER_WINDOW=60
RATE_LIMIT_REPLY_PER_WINDOW=60

# =============================================================================
# OpenTelemetry (optional)
# =============================================================================
# Enable tracing: true/false
OTEL_ENABLED=false
# OTLP collector endpoint (HTTP). Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Logical service name and environment
OTEL_SERVICE_NAME=ai-companion-backend
OTEL_ENVIRONMENT=dev

# =============================================================================
# Cookie/CORS Hardening (Dev Overrides)
# =============================================================================
# In development, disable Secure cookies so the browser can send them over HTTP
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
