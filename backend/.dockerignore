# Exclude unnecessary files from Docker build context
# This will significantly reduce image size

# Development files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.env.local
.env.development

# Testing
tests/
test_*.py
*_test.py
pytest.ini
.coverage
htmlcov/
.pytest_cache/

# Documentation
docs/
*.md
README*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Large data files
data/
uploads/
*.db
*.sqlite
*.sqlite3

# ML models (if not needed in production)
models/
*.pkl
*.h5
*.onnx

# Cache
.cache/
cache/

# Build artifacts
build/
dist/
*.egg-info/

# Docker files (except the one we're using)
Dockerfile
Dockerfile.ec2
docker-compose*.yml
