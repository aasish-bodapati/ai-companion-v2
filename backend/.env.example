# AI Companion v2 - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SECURITY (REQUIRED)
# =============================================================================
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# =============================================================================
# DATABASE
# =============================================================================
# For PostgreSQL (default for development and production)
SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/ai_companion_powerbi

# PostgreSQL database (required)

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# LLM Provider: "stub", "openrouter", "openai", "anthropic"
LLM_PROVIDER=stub
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model Configuration
LLM_MODEL_DEFAULT=stub-model
LLM_MODEL_FAST=stub-model
LLM_MODEL_VISION=stub-model
LLM_MODEL_SUMMARY=stub-model

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# ADMIN USER (for initial setup)
# =============================================================================
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=adminpassword123

# =============================================================================
# TESTING
# =============================================================================
# Test user credentials
TEST_USERNAME=test@example.com
TEST_PASSWORD=testpassword123

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================
# Redis for caching and rate limiting
REDIS_URL=

# OpenTelemetry for observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-companion-backend
OTEL_ENVIRONMENT=dev

# =============================================================================
# MEMORY & RETRIEVAL
# =============================================================================
MEMORY_ENABLED=true
MEMORY_PROVIDER=faiss
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_DATA_DIR=data/faiss

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Set to true for development mode
LLM_DEV_MODE=false