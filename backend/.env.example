# AI Companion v2 - Backend .env.example
# Copy this file to `.env` in the same directory and fill in values as needed.
# Never commit real secrets.

# ----------------------
# Server & CORS
# ----------------------
SERVER_NAME=ai-companion
SERVER_HOST=http://localhost:8000
# JSON list or comma-separated
# Example JSON: ["http://localhost:3000", "http://127.0.0.1:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ----------------------
# Auth / JWT
# ----------------------
# Change this in your real .env
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256

# ----------------------
# Database
# ----------------------
# Preferred: a single URL. If set, overrides the derived Postgres URL.
# Examples:
#  - postgresql://postgres:postgres@localhost:5432/ai_companion
#  - postgresql+psycopg://postgres:postgres@localhost:5432/ai_companion
DATABASE_URL=

# Or configure components (used to derive SQLALCHEMY_DATABASE_URI when DATABASE_URL is blank)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_companion

# ----------------------
# Providers & API Keys
# ----------------------
# OpenRouter API key (required for LLM calls). Do NOT log this.
LLM_KEY=
# Optional: provider base URL (OpenAI-compatible). Defaults to OpenRouter.
# https://openrouter.ai/api/v1
LLM_BASE_URL=
# Models (optional overrides). Leave blank to use defaults in code.
# Default: meta-llama/llama-3.3-70b-instruct (70B parameters, excellent performance)
LLM_MODEL_DEFAULT=
# Fast: mistralai/mistral-small-3.2-24b-instruct (24B parameters, good speed)
LLM_MODEL_FAST=
LLM_MODEL_VISION=
LLM_MODEL_SUMMARY=

# ----------------------
# Feature Flags
# ----------------------
REGISTRATION_ENABLED=true

# Memory / Retrieval
MEMORY_ENABLED=true
MEMORY_PROVIDER=faiss
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FAISS_DATA_DIR=data/faiss
RETRIEVAL_TOP_K=8
RETRIEVAL_RECENT_MESSAGES=5
MEMORY_MIN_RELEVANCE=0.5
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_HALF_LIFE_DAYS=90
MEMORY_MAX_MEMORIES=500
MEMORY_FORGET_AGE_DAYS=90

# ----------------------
# Bootstrap Users (development only)
# ----------------------
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me
TEST_USERNAME=test@example.com
TEST_PASSWORD=change-me

# ----------------------
# Notes
# ----------------------
# - The application loads env from backend/.env regardless of CWD via app/core/config.py
# - Alembic reads DB URL from app.core.config in env.py; alembic.ini value is a fallback.
# - After creating a DB and .env, run migrations:
#     alembic upgrade head
