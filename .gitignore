# Root .gitignore for ai-companion-v2

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.python-version
.venv*/
backend/.venv*/
.mypy_cache/
.pytype/
.pytest_cache/
.coverage*
htmlcov/
.tox/
.ruff_cache/
*.log

# Env/config
.env
.env.*
*.local
*.backup

# Node/Frontend
node_modules/
frontend/.next/
frontend/.turbo/
frontend/.vercel/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/.playwright-cache/

# Playwright (root or frontend)
playwright-report/
.test-results/

# Reports/coverage

coverage/
coverage-*.json

# Build artifacts
build/
dist/
.next/
*.lock
package-lock.json
pnpm-lock.yaml
yarn.lock

# Data caches (keep schema/migrations under VCS; ignore generated indexes/dbs)
data/*.db
data/**/*.index
data/**/*.meta.json

# SQLite DBs
*.db
*.db-*

# Misc
*.tmp
*.swp
*.swo
*.orig

# IDE
.vscode/
.idea/
*.iml

# Snapshots (keep tests' golden snapshots tracked; do not ignore those)
# If you have any temporary snapshot updates, place them under .snapshots-local/
.snapshots-local/
